body {
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
}

.c {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
}

.cc {
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px;
}

.blck1 {
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    height: 100%;
    gap: 20px;
}

.blck2 {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    height: 100%;
    gap: 20px;
}

.blck3 {
    display: flex;
    flex-direction: row;
    flex-grow: 1;
    gap: 20px;
}

.b {
    flex-grow: 1;
    border: 5px solid mediumseagreen;
}

.spacer {
    background-color: mediumvioletred;
    height: 100%;
    margin-left: 1%;
    margin-right: 1%;
    flex-shrink: 1;
    flex-basis: 10%;
}

hr {
    margin: 0;
    border: 3px solid mediumseagreen;
}

.hc {
    gap: 20px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
}
